<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>me.code4me</id>
    <name>Code4Me V2</name>
    <vendor>AISE TU Delft</vendor>

    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.MyBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Code4Me V2" displayType="BALLOON" isLogByDefault="true" />

        <!--        These are the extension-point definitions for both types of providing a completion          -->
        <inline.completion.provider id="Code4Me V2"
                                    implementation="me.code4me.completion.PluginInlineCompletionProvider"/>
        <completion.contributor language="any"
                                implementationClass="me.code4me.completion.PluginCompletionContributor"
                                order="first"/>


        <toolWindow factoryClass="me.code4me.toolWindow.MyToolWindowFactory" id="MyToolWindow"/>
        <postStartupActivity implementation="me.code4me.startup.MyProjectActivity" />
        <postStartupActivity implementation="me.code4me.services.modules.telemetry.typingSpeedHelpers.TypingTelemetryStartup"/>


        // The settings extension points
        <applicationConfigurable
                parentId="tools"
                instance="me.code4me.settings.Code4MeConfigurable"
                displayName="Code4Me V2"
                id="me.code4me.settings.Code4MeConfigurable"
        />
    </extensions>
</idea-plugin>
