<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>me.code4me</id>
    <name>Code4Me V2</name>
    <vendor>AISE TU Delft</vendor>


    <depends>org.intellij.plugins.markdown</depends>
    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.MyBundle</resource-bundle>

    <actions>
        <action id="me.code4me.actions.TriggerInlineCompletionAction"
                class="me.code4me.actions.TriggerInlineCompletionAction"
                text="Trigger Inline Completion"
                description="Manually trigger inline completion">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift 9"/>
            <!--            the macOS equivalent is ctrl cmd shift 9-->
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="ctrl cmd shift 9"/>
            <add-to-group group-id="EditorActions" anchor="last"/>
        </action>
    </actions>


    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Code4Me V2" displayType="BALLOON" isLogByDefault="true" />

        <!--        These are the extension-point definitions for both types of providing a completion          -->
        <inline.completion.provider id="Code4Me V2"
                                    implementation="me.code4me.completion.PluginInlineCompletionProvider"/>
        <completion.contributor language="any"
                                implementationClass="me.code4me.completion.PluginCompletionContributor"
                                order="first"/>

        <toolWindow
                factoryClass="me.code4me.chatWindow.ChatWindowFactory"
                id="Code4Me V2"
                anchor="right"
                icon="/icons/pluginIcon.svg"
        />
        <postStartupActivity implementation="me.code4me.lifecycle.PluginStartupActivity" />

        <!-- The settings extension points -->
        <applicationConfigurable
                parentId="tools"
                instance="me.code4me.settings.Code4MeConfigurable"
                displayName="Code4Me V2"
                id="me.code4me.settings.Code4MeConfigurable"
        />

        <!-- Service registration for ChatWindowStateService -->
        <projectService serviceImplementation="me.code4me.chatWindow.components.persistence.ChatWindowStateService"/>
    </extensions>
</idea-plugin>