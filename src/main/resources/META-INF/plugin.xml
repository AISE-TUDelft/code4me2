<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>me.code4me</id>
    <name>Code4Me V2</name>
    <vendor>AISE TU Delft</vendor>


    <depends>org.intellij.plugins.markdown</depends>
    <depends>com.intellij.modules.platform</depends>

    <actions>
        <action id="me.code4me.actions.TriggerInlineCompletionAction"
                class="me.code4me.actions.TriggerInlineCompletionAction"
                text="Trigger Inline Completion"
                description="Manually trigger inline completion">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift 9"/>
            <add-to-group group-id="EditorActions" anchor="last"/>
        </action>
        <action id="me.code4me.actions.PrepareAcpAgentSessionAction"
                class="me.code4me.actions.PrepareAcpAgentSessionAction"
                text="Prepare Code4Me Agent Session"
                description="Prepare a one-time authenticated ACP launch grant for this project">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="me.code4me.research.actions.JoinResearchStudyAction"
                class="me.code4me.research.actions.JoinResearchStudyAction"
                text="Join Research Study..."
                description="Join a Code4Me research study with an enrollment code">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>


    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Code4Me V2" displayType="BALLOON" isLogByDefault="true" />

        <!--        These are the extension-point definitions for both types of providing a completion          -->
        <inline.completion.provider id="Code4Me V2"
                                    implementation="me.code4me.completion.PluginInlineCompletionProvider"/>
        <completion.contributor language="any"
                                implementationClass="me.code4me.completion.PluginCompletionContributor"
                                order="first"/>

        <toolWindow
                factoryClass="me.code4me.chatWindow.ChatWindowFactory"
                id="Code4Me V2"
                anchor="right"
                icon="/icons/pluginIcon.svg"
        />
        <postStartupActivity implementation="me.code4me.lifecycle.PluginStartupActivity" />

        <!-- The settings extension points -->
        <applicationConfigurable
                parentId="tools"
                instance="me.code4me.settings.Code4MeConfigurable"
                displayName="Code4Me V2"
                id="me.code4me.settings.Code4MeConfigurable"
        />
        <applicationConfigurable
                parentId="me.code4me.settings.Code4MeConfigurable"
                instance="me.code4me.settings.ConfigurationConfigurable"
                displayName="Configuration"
                id="me.code4me.settings.ConfigurationConfigurable"/>
        <applicationConfigurable
                parentId="me.code4me.settings.Code4MeConfigurable"
                instance="me.code4me.settings.UserConfigurable"
                displayName="User Profile"
                id="me.code4me.settings.UserConfigurable"/>

        <!-- Service registration for ChatWindowStateService -->
        <projectService serviceImplementation="me.code4me.chatWindow.components.persistence.ChatWindowStateService"/>

        <!-- Research participant services (Issue 10). Inactive until a study is activated. -->
        <projectService serviceImplementation="me.code4me.research.ide.IntellijIdeActivitySource"/>
        <projectService serviceImplementation="me.code4me.research.session.ResearchSessionService"/>
        <projectService serviceImplementation="me.code4me.research.session.ResearchRuntimeSettings"/>
        <projectService serviceImplementation="me.code4me.research.actions.ResearchEnrollmentSettings"/>

        <!-- Lazily re-activate a previously joined study; fully guarded, never blocks startup. -->
        <postStartupActivity implementation="me.code4me.research.lifecycle.ResearchActivationStartupActivity" />

        <!-- Participant status surface (Issue 10): public status bar + editor banner. -->
        <statusBarWidgetFactory id="me.code4me.research.status"
                                implementation="me.code4me.research.status.ResearchStatusBarWidgetFactory"/>
        <editorNotificationProvider implementation="me.code4me.research.status.ResearchEditorNotificationProvider"/>
    </extensions>
</idea-plugin>